    "decompress": "^4.2.1",
    "garmin-connect": "^1.6.2",
    "google-auth-library": "^11.3.0",
    "googleapis": "^185.0.0",
    "lodash": "^4.18.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "strava-v3": "^4.0.2"
  },
  "devDependencies": {
    "@types/jest": "29",
    "@types/lodash": "^4.17.26",
    "@types/node": "^20",
    "jest": "29",
    "nodemon": "^3.1.14",
    "ts-jest": "29",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
